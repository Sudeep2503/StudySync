<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subject"
        android:textColor="#292344"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerSessionSubject"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp" />

    <EditText
        android:id="@+id/etSessionTopic"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:hint="Topic name"
        android:inputType="text"
        android:padding="12dp" />

    <EditText
        android:id="@+id/etSessionDate"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="false"
        android:hint="Select date"
        android:inputType="none"
        android:padding="12dp" />

    <EditText
        android:id="@+id/etSessionTime"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="false"
        android:hint="Select start time"
        android:inputType="none"
        android:padding="12dp" />

    <EditText
        android:id="@+id/etSessionDuration"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="8dp"
        android:hint="Duration in minutes"
        android:inputType="number"
        android:padding="12dp" />

</LinearLayout>