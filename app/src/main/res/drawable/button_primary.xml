<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed -->
    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <gradient
                android:angle="0"
                android:startColor="#8B24D6"
                android:endColor="#D946EF" />

            <corners
                android:radius="30dp" />

        </shape>

    </item>

    <!-- Normal -->
    <item>

        <shape android:shape="rectangle">

            <gradient
                android:angle="0"
                android:startColor="#9333EA"
                android:endColor="#FF2BC2" />

            <corners
                android:radius="30dp" />

        </shape>

    </item>

</selector>